# PostgreSQL bağlantı bilgileri. Yerel geliştirmede docker-compose.yml ile
# eşleşir; PRODUCTION'DA Neon'un (ya da başka bir barındırılan Postgres'in)
# verdiği host/port/kullanıcı/şifre buraya yazılır.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dijital_gardirop
DB_USER=postgres
DB_PASSWORD=postgres

# TLS ile bağlan — Neon (ve genel olarak barındırılan çoğu Postgres) SSL
# ZORUNLU tutar; yerel Docker Postgres'te SSL kurulu OLMADIĞI için burada
# varsayılan `false` bırakılmalıdır. Sertifika doğrulaması AÇIKTIR
# (`rejectUnauthorized` kapatılmadı) — Neon'un genel ucu herkese güvenilen
# bir CA kullanıyor, doğrulamayı kapatmanın bir gerekçesi yok.
DB_SSL=false

# API sunucu portu
PORT=3001

# JWT imzalama anahtarı — token'lar bununla imzalanır ve doğrulanır.
# Geliştirmede herhangi bir değer iş görür, ancak PRODUCTION'DA MUTLAKA
# uzun ve rastgele bir değerle değiştirilmelidir. Değiştirildiğinde
# mevcut tüm token'lar geçersiz olur (kullanıcılar yeniden giriş yapar).
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=gelistirme-icin-gizli-anahtar-uretimde-degistirin

# Access token (kısa ömürlü) geçerlilik süresi (jsonwebtoken formatı: 60,
# "2 days", "7d", "10h", "15m"). BİLEREK KISA TUTULMALIDIR (15 dakika - 1 saat
# önerilir): kullanıcı oturumunun GERÇEK süresi artık bu değerden değil,
# aşağıdaki REFRESH_TOKEN_EXPIRES_IN'den gelir. Access token süresi dolduğunda
# frontend arka planda otomatik yeniler (bkz. lib/api.js > tryRefreshSession),
# kullanıcı hiçbir şey fark etmez — bu değeri eskisi gibi "7d" gibi uzun tutmak
# kısa ömürlü access token'ın GÜVENLİK AMACINI (çalınması durumunda saldırı
# penceresini daraltmak) boşa çıkarır.
JWT_EXPIRES_IN=15m

# Refresh token geçerlilik süresi — AYNI biçim (jsonwebtoken'ınkiyle uyumlu:
# "30d", "12h", "15m", ya da düz saniye). Bu değer JWT'ye GÖMÜLMEZ (refresh
# token bir JWT değil, opak rastgele bir dizedir); veritabanında yalnızca
# bcrypt özeti + bu süreden hesaplanan bir bitiş tarihi (refresh_token_expires_at)
# saklanır. Her başarılı /auth/refresh çağrısı bu tarihi NOW() + bu süre olarak
# YENİLER (kayan pencere) — aktif kullanan bir kullanıcı süresiz oturumda
# kalabilir, yalnızca hiç dönmeyen bir kullanıcının oturumu bu süre sonunda
# gerçekten düşer.
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS: yalnızca bu listedeki origin'lerden gelen tarayıcı istekleri kabul
# edilir (virgülle ayrılmış). Geliştirme (http://localhost:5173) ve Capacitor
# (http://localhost, capacitor://localhost) origin'leri KOD İÇİNDE varsayılan
# olarak zaten tanımlıdır — buraya yazdığınız değerler onların ÜZERİNE
# YAZILMAZ, EK olarak eklenir. Yalnızca gerçek bir production frontend origin'i
# (ör. https://dijitalgardirop.com) eklemeniz gerektiğinde doldurun.
# BOŞ BIRAKILABİLİR: yalnızca varsayılan origin'ler geçerli olur.
CORS_ALLOWED_ORIGINS=

# --- Şifre sıfırlama e-postası (Resend) ---
# Resend (https://resend.com) üzerinden gönderilir — ücretsiz katmanı ayda
# 3000 e-postaya kadar yeterlidir. Hesap açıp "API Keys" sekmesinden alınır.
#
# BOŞ BIRAKILABİLİR: anahtar yoksa "şifremi unuttum" isteği sessizce e-posta
# GÖNDERMEZ (sunucu log'una uyarı düşer) ama kullanıcıya YİNE DE aynı
# "gönderildi" yanıtı döner — hangi e-postaların kayıtlı olduğu sızmasın diye.
RESEND_API_KEY=

# Gönderen adresi, ör: "Dijital Gardırop <bildirim@dijitalgardirop.com>".
# BOŞ BIRAKILIRSA Resend'in kendi test adresi (onboarding@resend.dev)
# kullanılır — bu adres YALNIZCA Resend hesabınızın kendi sahibinin
# e-postasına gönderim yapabilir (Resend'in sandbox kısıtı). Gerçek
# kullanıcılara göndermek için Resend'de bir alan adı doğrulayıp buraya
# yazmanız gerekir.
RESEND_FROM_ADDRESS=

# Sıfırlama bağlantısının geçerlilik süresi (jsonwebtoken formatı: "1h",
# "30m" vb.). Boş bırakılırsa 1 saat kullanılır.
PASSWORD_RESET_EXPIRES_IN=1h

# Frontend'in canlı adresi — sıfırlama e-postasındaki bağlantı buraya göre
# kurulur (ör. https://dijital-gardirop-red.vercel.app). BOŞ BIRAKILIRSA
# yerel geliştirme adresi (http://localhost:5173) kullanılır. SONUNA "/"
# EKLEMEYİN.
FRONTEND_URL=

# --- Fotoğraf depolama (Cloudflare R2) ---
# Render'ın disk alanı EPHEMERAL'dır (bir sonraki deploy'da sessizce
# sıfırlanabilir) — kıyafet fotoğrafları bu yüzden yerel diskin YANINDA
# Cloudflare R2'ye de yansıtılır (R2, S3 API'siyle uyumlu bir nesne deposu).
#
# BOŞ BIRAKILABİLİR: beşi de dolu değilse fotoğraflar eskisi gibi YALNIZCA
# yerel diske yazılır (WeatherService/GeminiService ile AYNI "anahtar yoksa
# dış servise hiç gidilmez" ilkesi) — sunucu patlamaz, özellik sessizce devre
# dışı kalır.
#
# Kurulum: Cloudflare panelinde R2 > "Create bucket" ile bir bucket açın,
# bucket ayarlarından "Public access"i açıp r2.dev alt alan adını (ya da
# bağladığınız özel alan adını) not edin; R2 > "Manage API tokens" ile
# Object Read & Write izinli bir API token oluşturun.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Bucket'ın herkese açık okuma adresi, SONUNDA "/" OLMADAN
# (ör. https://pub-xxxxxxxx.r2.dev ya da https://foto.dijitalgardirop.com).
R2_PUBLIC_URL=

# OpenWeatherMap API anahtarı — Kombin Öner sayfasındaki hava durumu filtresi için.
# Ücretsiz anahtar: https://openweathermap.org/api → ücretsiz hesap açıp
# "API keys" sekmesinden alınır. Yeni anahtarların aktifleşmesi birkaç dakika sürebilir.
#
# BOŞ BIRAKILABİLİR: anahtar yoksa hava durumu "bilinmiyor" döner ve kombin
# önerisi eskisi gibi (yalnızca temiz/kirli filtresiyle) çalışır. Sunucu patlamaz.
WEATHER_API_KEY=

# Google Gemini API anahtarı — otomatik kıyafet analizi, yeniden analiz,
# ten tonu analizi ve embedding üretimi için kullanılır.
# Anahtar: https://aistudio.google.com/apikey
#
# BOŞ BIRAKILABİLİR: anahtar yoksa sunucu normal açılır ve uygulamanın geri
# kalanı (Gemini dışındaki her şey) tam çalışır; yalnızca analiz uçları 503
# ile "anahtar tanımlı değil" der.
GEMINI_API_KEY=

# Kullanılacak model. Boş bırakılırsa gemini-3.6-flash kullanılır.
# NOT: gemini-1.5-flash ve gemini-2.0-flash emekliye ayrıldı; gemini-2.5-flash
# ise listede görünse de yeni anahtarlarla 404 veriyor. Model listesi:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=ANAHTAR"
# Ama LİSTEDE OLMASI kullanılabilir olduğu anlamına gelmiyor — değiştirmeden
# önce gerçekten çağırarak doğrulayın.
GEMINI_MODEL=

# --- Vektör depolama (pgvector, Aşama 3) ---
# Vektör deposu ARTIK ChromaDB DEĞİL — aynı Postgres veritabanının içindeki
# `vector` uzantısı ve `clothing_item_embeddings` tablosudur (bkz. CLAUDE.md
# §9, 2026-08-27 kaydı — "ChromaDB'den pgvector'a geçiş"). Ayrı bir host/port/
# koleksiyon adı YOKTUR — DB_* değişkenleri zaten yeterlidir. Yerel Docker
# imajı bu yüzden `pgvector/pgvector:pg16`dır (bkz. docker-compose.yml);
# migration `011_add_vector_store.sql` `CREATE EXTENSION vector` ve tabloyu kurar.
#
# false yapılırsa vektör katmanı TAMAMEN kapanır: embedding üretilmez ve
# /clothing-items/:id/similar 503 döner. Uygulamanın geri kalanı etkilenmez.
VECTOR_STORE_ENABLED=true

# Embedding modeli. Boş bırakılırsa gemini-embedding-001 kullanılır.
# NOT: text-embedding-004 emekliye ayrıldı (embedContent için 404 veriyor).
# MODELİ DEĞİŞTİRMEK MEVCUT TABLOYU GEÇERSİZ KILAR — farklı modellerin
# vektörleri aynı uzayda değildir (ayrıca 3072'den farklı bir boyut,
# migration'daki `vector(3072)` kolon tanımının da güncellenmesini gerektirir).
# Değiştirdiyseniz:
#   node test-scripts/create-embeddings.js --sifirla --uygula
GEMINI_EMBEDDING_MODEL=
